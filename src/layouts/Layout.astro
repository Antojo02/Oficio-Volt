---
const {
  title = 'OficioVolt',
  description = 'OficioVolt · Electricista en Murcia y alrededores para urgencias, mejoras y telecom.',
  lang = 'es',
  canonical = '/',
  robots = 'index,follow,max-image-preview:large'
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OficioVolt" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={"https://oficiovolt.es" + canonical} />
    <meta property="og:image" content="/assets/oficiovolt-logo-brand.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/assets/oficiovolt-logo-brand.png" />
    <link rel="canonical" href={"https://oficiovolt.es" + canonical} />
    <link rel="icon" type="image/png" href="/assets/oficiovolt-icon.png" />
    <style is:global>
      :root {
        --bg: #f3f6fb;
        --bg-soft: #edf6ff;
        --card: #ffffff;
        --line: rgba(148, 163, 184, 0.32);
        --text: #0f172a;
        --muted: #475569;
        --dark: #0b1320;
        --dark-2: #0a1220;
        --green: #16a34a;
        --greenbg: #ecfdf5;
        --greenline: #bbf7d0;
        --accent: #38bdf8;
        --accent-soft: #dff7ff;
        --amber: #f59e0b;
        --amber-strong: #f97316;
        --warm: #fff7ed;
        --warmline: #fed7aa;
        --shadow: 0 20px 50px rgba(15, 23, 42, 0.10);
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; overflow-x: hidden; }
      body {
        margin: 0;
        width: 100%;
        overflow-x: hidden;
        font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
        background: linear-gradient(180deg, #f4f7fb 0%, #edf4ff 100%);
        color: var(--text);
        line-height: 1.55;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      a { color: inherit; text-decoration: none; }
      img { max-width: 100%; }
      picture { display: block; max-width: 100%; }
      .container {
        width: min(1180px, calc(100% - 32px));
        margin: 0 auto;
      }
      body.cookie-banner-visible {
        overflow: hidden;
      }
      main { flex: 1 0 auto; }
      .cookie-banner-backdrop {
        position: fixed;
        inset: 0;
        z-index: 140;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background: rgba(15, 23, 42, 0.46);
        backdrop-filter: blur(4px);
      }
      .cookie-banner-backdrop.visible {
        display: flex;
      }
      .cookie-banner {
        width: min(560px, calc(100% - 16px));
        background: linear-gradient(180deg, rgba(255,255,255,0.98), rgba(248,250,252,0.98));
        border: 1px solid rgba(148,163,184,0.35);
        border-radius: 28px;
        box-shadow: 0 40px 80px rgba(15, 23, 42, 0.18);
        padding: 26px 24px 20px;
      }
      .cookie-banner h3 {
        margin: 0 0 12px;
        font-size: clamp(1.4rem, 2vw, 2rem);
        letter-spacing: -0.03em;
      }
      .cookie-banner p {
        margin: 0 0 18px;
        color: var(--muted);
        line-height: 1.7;
      }
      .cookie-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 12px;
      }
      .cookie-banner .btn {
        min-width: 150px;
      }
      .cookie-details {
        display: none;
        margin-top: 14px;
        border: 1px solid rgba(148,163,184,0.28);
        border-radius: 16px;
        background: rgba(15, 23, 42, 0.02);
        padding: 14px 16px;
      }
      .cookie-details.expanded {
        display: block;
      }
      .cookie-details p {
        margin: 0 0 10px;
      }
      .cookie-details ul {
        margin: 0;
        padding-left: 18px;
        color: var(--muted);
        line-height: 1.7;
      }

      /* helper to center main content vertically when desired */
      .main-center { display: flex; align-items: center; }
      .error-page { min-height: calc(100vh - 120px); padding: 64px 0; }
      .error-page-inner {
        display: grid;
        grid-template-columns: minmax(260px, 420px) minmax(0, 1fr);
        gap: clamp(28px, 5vw, 72px);
        align-items: center;
      }
      .error-visual { display: flex; justify-content: center; }
      .error-visual img {
        display: block;
        width: min(100%, 360px);
        aspect-ratio: 1;
        object-fit: cover;
        border-radius: 24px;
        box-shadow: 0 24px 48px rgba(15,23,42,0.12);
      }
      .error-copy { min-width: 0; }
      .error-copy .title { max-width: 680px; }
      .topbar {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(10, 17, 26, 0.96);
        backdrop-filter: blur(14px);
        border-bottom: 1px solid rgba(148, 163, 184, 0.18);
        box-shadow: 0 8px 22px rgba(15,23,42,.12);
        transition: background .22s ease, box-shadow .22s ease, padding .22s ease;
      }
      .topbar .inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 12px 0;
        transition: padding .22s ease;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 8px 12px 8px 8px;
        border-radius: 16px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(125,211,252,0.18);
        backdrop-filter: blur(8px);
      }
      .brand-logo-img {
        display: block;
        height: 58px;
        width: auto;
        max-width: min(440px, 42vw);
        filter: drop-shadow(0 8px 18px rgba(52,211,153,0.18));
      }
      .nav {
        display: flex;
        gap: 18px;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
      }
      .nav-group { position: relative; }
      .nav-group-toggle {
        background: transparent; color: rgba(255,255,255,0.92); border: none; font-weight:700; cursor:pointer; padding:6px 10px; border-radius:10px; display:inline-flex; gap:8px; align-items:center; transition: background .2s ease, color .2s ease, transform .2s ease;
      }
      .nav-group-toggle:hover {
        background: rgba(255,255,255,0.05);
        color: #fff;
      }
      .nav-group-toggle svg { width:14px;height:14px;transform:translateY(1px);transition:transform .18s ease; }
      .nav-group.open .nav-group-toggle svg { transform: rotate(180deg) translateY(0); }
      /* compact dropdown for services */
      .submenu {
        position: absolute;
        left: 50%;
        transform: translateX(-50%) translateY(-8px);
        top: calc(100% + 12px);
        width: min(360px, 82vw);
        background: linear-gradient(180deg, rgba(15,23,42,0.96), rgba(17,24,39,0.96));
        color: #fff;
        border: 1px solid rgba(148,163,184,0.18);
        border-radius: 18px;
        padding: 12px;
        display: none;
        box-shadow: 0 24px 46px rgba(2,6,23,0.34);
        z-index: 1000;
        opacity: 0;
        transform-origin: top center;
        transition: opacity .24s ease, transform .24s ease;
        backdrop-filter: blur(14px);
      }
      .submenu .col {
        display:flex;
        flex-direction:column;
        gap:6px;
      }
      .submenu a {
        display:block;
        padding:10px 12px;
        color: rgba(255,255,255,0.9);
        font-weight:700;
        border-radius:10px;
        font-size: 14px;
        transition: background .18s ease, color .18s ease, transform .18s ease;
      }
      .submenu a:hover {
        background: rgba(255,255,255,0.06);
        color: #fff;
        transform: translateX(2px);
      }
      .nav-group.open .submenu {
        display:block;
        opacity:1;
        transform: translateX(-50%) translateY(0);
      }
      .submenu-backdrop { position: fixed; inset: 0; background: rgba(2,6,23,0.28); z-index: 900; display: none; opacity:0; transition: opacity .28s ease; }
      body.submenu-open .submenu-backdrop { display:block; opacity:1; }
      .nav a {
        font-size: 13px;
        color: rgba(255,255,255,0.78);
        font-weight: 700;
        letter-spacing: 0.01em;
        transition: color .2s ease, transform .2s ease;
      }
      .nav a:hover {
        color: #fff;
        transform: translateY(-1px);
      }
      .nav-toggle {
        display: none;
        width: 44px;
        height: 44px;
        border: 1px solid rgba(255,255,255,0.14);
        background: rgba(255,255,255,0.04);
        color: #fff;
        border-radius: 12px;
        cursor: pointer;
      }
      /* compact header when scrolled */
      .topbar.scrolled {
        background: rgba(10, 17, 26, 0.98);
        box-shadow: 0 8px 20px rgba(15,23,42,0.18);
      }
      .topbar.scrolled .inner { padding: 8px 0; }
      .topbar.scrolled .brand-logo-img { height: 40px; }
      .nav-toggle .bar {
        display: block;
        width: 20px;
        height: 2px;
        background: #fff;
        border-radius: 2px;
        margin: 5px auto;
        transition: transform .22s ease, opacity .18s ease;
      }
      .topbar.nav-open .nav-toggle .bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
      .topbar.nav-open .nav-toggle .bar:nth-child(2) { opacity: 0; }
      .topbar.nav-open .nav-toggle .bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        border-radius: 999px;
        padding: 14px 20px;
        font-weight: 700;
        border: 1px solid transparent;
        transition: transform .2s ease, box-shadow .2s ease;
        cursor: pointer;
      }
      .btn:hover { transform: translateY(-1px); }
      .btn-primary { background: linear-gradient(135deg, var(--amber), var(--amber-strong)); color: #111827; box-shadow: 0 14px 34px rgba(245, 158, 11, 0.25); }
      .btn-light { background: #fff; color: var(--text); border-color: var(--line); }
      .btn-green { background: var(--greenbg); color: #065f46; border-color: var(--greenline); }
      .btn-bono-access { background: var(--amber-strong); color: #fff; border-color: var(--amber-strong); }
      .hero {
        padding: 62px 0 42px;
        background:
          radial-gradient(circle at top left, rgba(56, 189, 248, 0.16), transparent 26%),
          radial-gradient(circle at top right, rgba(245, 158, 11, 0.12), transparent 28%),
          linear-gradient(180deg, rgba(4, 16, 29, 0.02) 0%, rgba(255,255,255,0) 100%);
      }
      .narrow-hero { padding-bottom: 30px; }
      .hero-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 28px;
        align-items: center;
      }
      .hero-visual {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 420px;
        padding: 0;
        border: none;
        background: transparent;
        box-shadow: none;
        overflow: visible;
      }
      .hero-visual-wide {
        width: 100%;
      }
      .hero-visual-frame {
        position: relative;
        width: 100%;
        max-width: 100%;
        min-height: 420px;
        margin: 0;
        border-radius: 30px;
        overflow: hidden;
        border: 1px solid rgba(125, 211, 252, 0.28);
        box-shadow: 0 30px 60px rgba(15, 23, 42, 0.18);
      }
      .floating-whatsapp {
        position: fixed;
        right: 24px;
        bottom: 26px;
        z-index: 60;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 62px;
        height: 62px;
        border-radius: 50%;
        background: linear-gradient(135deg, #d9f9ee 0%, #c3f5da 100%);
        border: 1px solid rgba(22, 163, 74, 0.25);
        box-shadow: 0 20px 36px rgba(22, 163, 74, 0.18);
        text-decoration: none;
      }
      .floating-whatsapp-icon {
        display: block;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        object-fit: contain;
        filter: drop-shadow(0 8px 12px rgba(34,197,94,0.18));
      }
      .hero-visual-frame::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 1;
        background: linear-gradient(90deg, rgba(11,19,32,0.12) 0%, rgba(11,19,32,0.22) 45%, rgba(11,19,32,0.48) 100%);
      }
      .hero-visual img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: saturate(1.05) contrast(1.06);
        transform: scale(1.12);
      }
      .hero-photo-overlay {
        position: absolute;
        left: 24px;
        bottom: 24px;
        z-index: 2;
        max-width: 360px;
        padding: 18px 18px 14px;
        border-radius: 18px;
        background: rgba(11, 19, 32, 0.42);
        border: 1px solid rgba(255,255,255,0.18);
        backdrop-filter: blur(10px);
        color: #fff;
      }
      .hero-photo-overlay span {
        display: inline-block;
        margin-bottom: 8px;
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.78);
      }
      .hero-photo-overlay strong {
        display: block;
        font-size: clamp(22px, 2vw, 36px);
        line-height: 1.08;
        letter-spacing: -0.04em;
        margin-bottom: 8px;
      }
      .hero-photo-overlay small {
        display: block;
        color: rgba(255,255,255,0.82);
        font-size: 14px;
        line-height: 1.5;
      }
      .hero-visual-note {
        display: flex;
        flex-direction: column;
        gap: 4px;
        width: min(100%, 440px);
        margin-top: 16px;
        padding-left: 10px;
      }
      .hero-visual-note strong {
        display: block;
        font-size: clamp(16px, 1.8vw, 22px);
        line-height: 1.2;
        letter-spacing: -0.03em;
        color: var(--text);
      }
      .hero-visual-note span {
        color: var(--muted);
        font-size: 14px;
      }
      .hero-copy {
        align-self: center;
      }
      .eyebrow, .kicker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: 1px solid var(--line);
        background: #fff;
        border-radius: 999px;
        padding: 10px 14px;
        font-size: 12px;
        font-weight: 800;
        color: var(--muted);
        letter-spacing: .12em;
        text-transform: uppercase;
      }
      h1 {
        font-size: clamp(36px, 5vw, 64px);
        line-height: 1.02;
        margin: 18px 0;
        letter-spacing: -.04em;
      }
      .lead {
        font-size: clamp(18px, 2vw, 22px);
        color: var(--muted);
        max-width: 760px;
      }
      .actions, .chips, .inline-links {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 22px;
      }
      .chip {
        background: #fff;
        border: 1px solid var(--line);
        padding: 10px 14px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 600;
        color: var(--muted);
      }
      .hero-trust {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 18px;
      }
      .hero-trust .mini-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 12px;
        border-radius: 999px;
        border: 1px solid rgba(20, 184, 166, 0.18);
        background: rgba(16, 185, 129, 0.05);
        color: #0f766e;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }
      .quick-card, .contact-card, .card, .box, .price, .step, .faq, .plan-box {
        background: var(--card);
        border: 1px solid rgba(148, 163, 184, 0.32);
        border-radius: 28px;
        padding: 22px;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.04);
      }
      .quick-card {
        background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
        border: 1px solid rgba(56, 189, 248, 0.18);
        box-shadow: 0 24px 48px rgba(15, 23, 42, 0.10);
      }
      .quick-card h3, .contact-card h3, .card h3, .box h3, .price h3, .step h3, .faq h3, .plan-box h3 { margin-top: 0; }
      .quick-card p, .contact-card p, .card p, .box p, .price p, .step p, .faq p, .plan-box p { color: var(--muted); }
      .quick-card .benefits {
        display: grid;
        gap: 10px;
        margin-top: 18px;
      }
      .quick-card .benefit {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        border-radius: 12px;
        background: rgba(56, 189, 248, 0.05);
        border: 1px solid rgba(56, 189, 248, 0.12);
        color: var(--text);
        font-weight: 700;
      }
      .quick-card .benefit::before {
        content: "✓";
        display: inline-grid;
        place-items: center;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: linear-gradient(135deg, #dff7ff, #bbf7d0);
        color: #0f766e;
        font-size: 12px;
      }
      .stat-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0,1fr));
        gap: 12px;
        margin-top: 18px;
      }
      .stat {
        display: block;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 18px;
        padding: 14px 12px;
        text-align: center;
      }
      .stat .label { font-size: 12px; color: var(--muted); font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
      .stat .value { font-size: 26px; font-weight: 800; margin-top: 6px; }
      .section { padding: 62px 0; }
      .section-alt { background: #fff; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
      .title { font-size: clamp(28px, 3vw, 42px); margin: 12px 0 12px; letter-spacing: -.03em; font-weight: 900; }
      .subtitle { color: var(--muted); max-width: 760px; margin-bottom: 24px; }
      .cards {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 28px;
      }
      .card {
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        min-height: 240px;
        height: 100%;
        background: linear-gradient(180deg, rgba(255,255,255,0.96) 0%, rgba(248,250,252,0.96) 100%);
        border: 1px solid rgba(148, 163, 184, 0.28);
        border-radius: 30px;
        transition: transform .32s ease, box-shadow .32s ease, border-color .32s ease, background .32s ease;
        will-change: transform;
      }
      .card h3 {
        margin: 0 0 14px;
        font-size: clamp(1.05rem, 1.5vw, 1.7rem);
        line-height: 1.22;
        letter-spacing: -.03em;
        font-weight: 700;
      }
      .card p {
        margin: 0;
        color: rgba(15, 23, 42, 0.72);
      }
      .card:hover {
        transform: translateY(-12px) scale(1.016);
        box-shadow: 0 30px 60px rgba(15, 23, 42, 0.12), 0 0 0 1px rgba(56, 189, 248, 0.08);
        border-color: rgba(56, 189, 248, 0.42);
      }
      /* Additional hover effects reused across components */
      .metric-box, .trust-item, .plan-cols .plan-col, .showcase-item, .feature-box {
        transition: transform .24s ease, box-shadow .24s ease, border-color .24s ease, background .24s ease;
        will-change: transform;
      }
      .metric-box:hover,
      .trust-item:hover,
      .plan-cols .plan-col:hover,
      .showcase-item:hover,
      .feature-box:hover {
        transform: translateY(-8px);
        box-shadow: 0 28px 48px rgba(15,23,42,0.12);
        border-color: rgba(56,189,248,0.10);
      }
      .plan-cols .plan-col:hover { border-color: var(--greenline); }

      /* Buttons hover (primary, light and form whatsapp button) */
      .btn-primary {
        transition: transform .18s ease, box-shadow .18s ease;
      }
      .btn-primary:hover {
        transform: translateY(-3px) scale(1.01);
        box-shadow: 0 18px 40px rgba(245,158,11,0.28);
      }
      .btn-light {
        transition: transform .18s ease, box-shadow .18s ease, background .18s ease;
      }
      .btn-light:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 28px rgba(15,23,42,0.08);
        border-color: rgba(15,23,42,0.06);
      }
      #wa-send {
        transition: transform .16s ease, box-shadow .16s ease;
      }
      #wa-send:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(15,23,42,0.08); }

      /* Floating WhatsApp button hover/glow */
      .floating-whatsapp { transition: transform .18s ease, box-shadow .18s ease; }
      .floating-whatsapp:hover { transform: translateY(-6px) scale(1.04); box-shadow: 0 30px 60px rgba(22,163,74,0.22); }
      .three-cols { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .card .icon { font-size: 2rem; margin-bottom: 12px; }
      .metrics-strip {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-top: 18px;
      }
      .trust-strip {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-top: 10px;
      }
      .trust-item {
        display: block;
        padding: 18px 20px;
        border-radius: 20px;
        background: linear-gradient(180deg, rgba(15,23,42,0.96) 0%, rgba(17,24,39,1) 100%);
        border: 1px solid rgba(148,163,184,0.18);
        color: #edf6ff;
        box-shadow: 0 18px 36px rgba(15, 23, 42, 0.12);
      }
      .trust-item strong {
        display: block;
        font-size: 18px;
        margin-bottom: 4px;
        letter-spacing: -.03em;
      }
      .trust-item span {
        display: block;
        color: rgba(226, 232, 240, 0.75);
