        .brand-logo-img { height: 44px; }
        .cards, .price-grid, .steps, .faq-grid, .two-col-list, .plan-cols, .contact-grid, .client-layout, .footer-grid, .feature-grid, .metrics-strip, .showcase { grid-template-columns: 1fr; }
        .topbar .btn { display: none; }
        .brand-logo-img { max-width: 68vw; }
        .floating-whatsapp { display: none; }
        main { padding: 20px 0; }
      }
      @media (max-width: 390px) {
        .cta-banner-copy h3 { font-size: 1.28rem; }
        .cta-banner-copy p { font-size: .86rem; }
        .cta-banner-actions .btn { font-size: .84rem; padding-inline: 6px; }
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="container inner">
        <a class="brand" href="/" aria-label="OficioVolt inicio">
          <img class="brand-logo-img" src="/assets/oficiovolt-logo-brand.png" alt="OficioVolt" />
        </a>

        <button class="nav-toggle" type="button" aria-label="Abrir menú" aria-expanded="false">
          <span class="bar"></span>
          <span class="bar"></span>
          <span class="bar"></span>
        </button>

        <nav class="nav" aria-label="Navegación principal">
          <div class="nav-group" role="group">
            <button class="nav-group-toggle" aria-expanded="false">Servicios
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="submenu" role="menu">
              <div class="col">
                <a role="menuitem" href="/urgencias-electricas-murcia/">Urgencias eléctricas</a>
                <a role="menuitem" href="/reparacion-tecnica-murcia/">Reparación técnica</a>
              </div>
              <div class="col">
                <a role="menuitem" href="/domotica-murcia/">Domótica</a>
                <a role="menuitem" href="/telecomunicaciones-murcia/">Telecomunicaciones</a>
              </div>
            </div>
          </div>
          <a href="/bono-anual-oficiovolt/">Bono anual</a>
          <a href="/consulta-bono/">Área clientes</a>
          <a href="/contacto/">Contacto</a>
        </nav>
        <a class="btn btn-primary" href="/contacto/">Cuéntame qué necesitas</a>
        <div class="submenu-backdrop" aria-hidden="true"></div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer-grid">
        <div>
          <img class="footer-logo" src="/assets/oficiovolt-logo-brand.png" alt="OficioVolt" />
          <p class="tiny">OficioVolt · Urgencias eléctricas, pequeñas instalaciones, ampliaciones, telecomunicaciones y domótica en Murcia y alrededores.</p>
        </div>

        <div>
          <div class="footer-section-title">Enlaces</div>
          <nav class="links">
            <a href="/">Inicio</a>
            <a href="/bono-anual-oficiovolt/">Bono anual</a>
            <a href="/consulta-bono/">Área clientes</a>
          </nav>
        </div>

        <div>
          <div class="footer-section-title">Contacto</div>
          <div class="contact-list">
            <div>675 970 679</div>
            <div>info@oficiovolt.es</div>
            <div>Calle Asturias, Polígono La Capellanía, Archena</div>
          </div>
        </div>
      </div>

      <div class="container footer-bottom">
        <div class="footer-copy">© <span id="footer-year"></span> OficioVolt</div>

        <nav class="footer-policies">
          <a href="/politica-proteccion-datos/">Política de protección de datos</a>
          <a href="/politica-cookies/">Política de cookies</a>
          <a href="/aviso-legal/">Aviso legal</a>
          <a href="/aviso-privacidad/">Aviso de privacidad</a>
        </nav>
      </div>
    </footer>

    <div id="cookie-banner" class="cookie-banner-backdrop" aria-live="polite" aria-hidden="true">
      <div class="cookie-banner" role="dialog" aria-modal="true" aria-labelledby="cookie-title">
        <h3 id="cookie-title">Aviso sobre cookies</h3>
        <p>Utilizamos cookies para mejorar tu experiencia en la web, recordar tus preferencias y analizar uso básico del sitio. Al aceptar, das tu consentimiento para su uso.</p>

        <div class="cookie-details" id="cookie-details">
          <p><strong>Qué usamos:</strong> cookies técnicas, de preferencias y de análisis para mejorar la navegación y la experiencia básica.</p>
          <ul>
            <li>Cookies técnicas necesarias para que la web funcione.</li>
            <li>Cookies para recordar opciones de navegación.</li>
            <li>Cookies de análisis para medir uso de la web sin identificarte personalmente.</li>
          </ul>
        </div>

        <div class="cookie-actions">
          <button class="btn btn-light" id="toggle-cookie-details" type="button" aria-expanded="false">Más información</button>
          <button class="btn btn-primary" id="accept-cookies" type="button">Aceptar</button>
        </div>
      </div>
    </div>

    <script is:inline>
      const COOKIE_CONSENT_KEY = 'oficiovolt_cookie_consent';
      function setCookieConsent(accepted) {
        try {
          localStorage.setItem(COOKIE_CONSENT_KEY, accepted ? 'accepted' : 'rejected');
        } catch (error) {
          console.warn('No se pudo guardar el consentimiento de cookies.', error);
        }
      }

      function hideCookieBanner() {
        const banner = document.getElementById('cookie-banner');
        if (!banner) return;
        banner.classList.remove('visible');
        banner.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('cookie-banner-visible');
      }

      document.addEventListener('DOMContentLoaded', () => {
        const header = document.querySelector('.topbar');
        const toggle = document.querySelector('.nav-toggle');
        const cookieBanner = document.getElementById('cookie-banner');
        const acceptCookies = document.getElementById('accept-cookies');
        const toggleCookieDetails = document.getElementById('toggle-cookie-details');
        const cookieDetails = document.getElementById('cookie-details');

        if (toggleCookieDetails && cookieDetails) {
          toggleCookieDetails.addEventListener('click', () => {
            const isExpanded = cookieDetails.classList.toggle('expanded');
            toggleCookieDetails.setAttribute('aria-expanded', String(isExpanded));
            toggleCookieDetails.textContent = isExpanded ? 'Ocultar información' : 'Más información';
          });
        }

        try {
          const consent = localStorage.getItem(COOKIE_CONSENT_KEY);
          if (consent === 'accepted' || consent === 'rejected') {
            hideCookieBanner();
          } else if (cookieBanner) {
            cookieBanner.classList.add('visible');
            cookieBanner.setAttribute('aria-hidden', 'false');
            document.body.classList.add('cookie-banner-visible');
          }
        } catch (error) {
          console.warn('No se pudo leer el consentimiento de cookies.', error);
          if (cookieBanner) {
            cookieBanner.classList.add('visible');
            cookieBanner.setAttribute('aria-hidden', 'false');
            document.body.classList.add('cookie-banner-visible');
          }
        }

        if (acceptCookies) {
          acceptCookies.addEventListener('click', () => {
            setCookieConsent(true);
            hideCookieBanner();
          });
        }

        if (header && toggle) {
          toggle.addEventListener('click', (event) => {
            event.stopPropagation();
            const isOpen = header.classList.toggle('nav-open');
            toggle.setAttribute('aria-expanded', String(isOpen));
            toggle.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
            if (!isOpen) closeAllNavGroups();
          });
          header.querySelectorAll('.nav a').forEach((link) => {
            link.addEventListener('click', () => {
              header.classList.remove('nav-open');
              toggle.setAttribute('aria-expanded', 'false');
              toggle.setAttribute('aria-label', 'Abrir menú');
            });
          });
        }

        function closeAllNavGroups() {
          document.querySelectorAll('.nav-group.open').forEach((g) => {
            g.classList.remove('open');
            const b = g.querySelector('.nav-group-toggle');
            if (b) b.setAttribute('aria-expanded', 'false');
          });
          document.body.classList.remove('submenu-open');
        }

        const navGroupButtons = document.querySelectorAll('.nav-group-toggle');
        navGroupButtons.forEach((btn) => {
          const group = btn.closest('.nav-group');
          if (!group) return;

          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const open = !group.classList.contains('open');
            document.querySelectorAll('.nav-group.open').forEach((g) => {
              if (g !== group) {
                g.classList.remove('open');
                const b = g.querySelector('.nav-group-toggle');
                if (b) b.setAttribute('aria-expanded', 'false');
              }
            });
            group.classList.toggle('open', open);
            btn.setAttribute('aria-expanded', String(open));
            document.body.classList.toggle('submenu-open', open);
          });
        });

        const submenuBackdrop = document.querySelector('.submenu-backdrop');
        if (submenuBackdrop) {
          submenuBackdrop.addEventListener('click', () => {
            closeAllNavGroups();
          });
        }

        document.addEventListener('click', (e) => {
          document.querySelectorAll('.nav-group.open').forEach((g) => {
            if (!g.contains(e.target)) {
              g.classList.remove('open');
              const b = g.querySelector('.nav-group-toggle');
              if (b) b.setAttribute('aria-expanded', 'false');
              document.body.classList.remove('submenu-open');
            }
          });
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            closeAllNavGroups();
          }
        });

        if (header) {
          const onScroll = () => {
            if (window.scrollY > 30) {
              if (header.classList.contains('nav-open')) {
                header.classList.remove('nav-open');
                const toggleButton = document.querySelector('.nav-toggle');
                if (toggleButton) toggleButton.setAttribute('aria-expanded', 'false');
              }
              closeAllNavGroups();
            }
          };
          onScroll();
          window.addEventListener('scroll', onScroll, { passive: true });
        }

        document.querySelectorAll('[data-whatsapp]').forEach((el) => {
          el.href = 'https://wa.me/34675970679?text=' + encodeURIComponent('Hola, quiero consultar un servicio de OficioVolt.');
          el.target = '_blank';
          el.rel = 'noreferrer';
        });

        const form = document.getElementById('request-form');
        const waButton = document.getElementById('wa-send');
        if (form && waButton) {
          waButton.addEventListener('click', () => {
            if (!form.reportValidity()) return;
            const data = new FormData(form);
            const labels = JSON.parse(form.dataset.labels || '{}');
            const order = ['clientType','clientNumber','authCode','serviceType','urgency','name','phone','email','area','propertyType','media','message'];
            const lines = [form.dataset.greeting || 'Hola, contacto desde la web de OficioVolt.', ''];
            for (const key of order) {
              const value = (data.get(key) || '').toString().trim();
              if (value) lines.push((labels[key] || key) + ': ' + value);
            }
            window.open('https://wa.me/34675970679?text=' + encodeURIComponent(lines.join('\n')), '_blank');
          });
        }
        document.querySelectorAll('form').forEach((currentForm) => {
          currentForm.addEventListener('submit', (event) => {
            if (!currentForm.checkValidity()) {
              event.preventDefault();
              currentForm.reportValidity();
            }
          });
        });
        // Footer year handling
        const yearEl = document.getElementById('footer-year');
        if (yearEl) yearEl.textContent = new Date().getFullYear();
      });
    </script>
  </body>
</html>
