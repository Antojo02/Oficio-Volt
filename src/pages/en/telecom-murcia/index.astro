---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Telecom in Murcia | OficioVolt" description="Telecom service in Murcia for cabling, network points, TV outlets, signal faults and small practical upgrades in homes, offices and small businesses." lang="en" canonical="/en/telecom-murcia/">
  <section class="hero narrow-hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Service area</span>
        <h1>Telecom in Murcia</h1>
        <p class="lead">Telecom service in Murcia for cabling, network points, TV outlets, signal faults and small practical upgrades in homes, offices and small businesses.</p>
        <div class="actions">
          <a class="btn btn-primary" href="/contacto/">Request a visit</a>
          <a class="btn btn-light" href="/bono-anual-oficiovolt/">Annual plan</a>
        </div>
      </div>
      <aside class="quick-card">
        <h3>Direct support</h3>
        <p>Fast and clear support across Murcia and nearby areas depending on schedule and job type.</p>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cards three-cols">
        <article class="card">
          <h3>Diagnosis and proposal</h3>
          <p>Clear review to choose the correct option: visit, urgent support or intervention.</p>
        </article>
        <article class="card">
          <h3>Coverage</h3>
          <p>Murcia, Vega Media, Vega Baja and nearby areas depending on availability and type of work.</p>
        </article>
        <article class="card">
          <h3>Direct contact</h3>
          <p>Send photos or video to assess the issue and give the most accurate option.</p>
        </article>
      </div>
    </div>
  </section>
</Layout>


