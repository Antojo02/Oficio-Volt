---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Electrical repairs in Murcia | OficioVolt" description="Electrical repair work in Murcia for small faults, technical fixes, troubleshooting and practical solutions for homes, offices and small businesses." lang="en" canonical="/en/electrical-repairs-murcia/">
  <section class="hero narrow-hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Service area</span>
        <h1>Electrical repairs in Murcia</h1>
        <p class="lead">Direct, practical support for faults, small technical issues and short interventions that need a clear diagnosis and a useful solution.</p>
        <div class="actions">
          <a class="btn btn-primary" href="/contacto/">Request a repair</a>
          <a class="btn btn-light" href="/bono-anual-oficiovolt/">Annual plan</a>
        </div>
      </div>
      <aside class="quick-card">
        <h3>Clear diagnosis</h3>
        <p>We assess the real issue first so the best option is chosen: a visit, quick intervention, urgent callout or annual plan.</p>
        <div class="benefits">
          <div class="benefit">Practical repair</div>
          <div class="benefit">Fast response</div>
          <div class="benefit">Clear guidance</div>
        </div>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="kicker">Typical work</span>
      <h2 class="title">Repairs that need a real fix</h2>
      <div class="cards three-cols">
        <article class="card">
          <h3>Small faults</h3>
          <p>Intermittent issues, short circuits, power loss or failures that need a precise and practical correction.</p>
        </article>
        <article class="card">
          <h3>Adjustments and changes</h3>
          <p>Small modifications to improve operation, reliability and safety without overcomplicating the job.</p>
        </article>
        <article class="card">
          <h3>Technical review</h3>
          <p>Assessment of the real cause before deciding whether repair, improvement or intervention is the most sensible option.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="cta-list">
        <a class="cta-box" href="/contacto/"><strong>Tell us about the problem</strong><span>Send the area, issue and urgency level so we can guide you properly.</span></a>
        <a class="cta-box" href="/bono-anual-oficiovolt/"><strong>Annual plan</strong><span>Useful for ongoing support and predictable technical help.</span></a>
      </div>
    </div>
  </section>
</Layout>


