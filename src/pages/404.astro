---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="section-alt error-page">
    <div class="container error-page-inner">
      <div class="error-visual">
        <img src="/assets/oficiovolt-icon.png" alt="OficioVolt" />
      </div>

      <div class="error-copy">
        <div class="pill" style="display:inline-block;margin-bottom:12px;">Error 404</div>
        <h1 class="title">Vaya — parece que no existe esta página</h1>
        <p class="lead">Ha ocurrido un problema o la página que buscas ya no está disponible. Puedes volver al inicio o visitar alguna de las secciones más útiles.</p>

        <div class="actions" style="margin-top:20px;display:flex;gap:12px;flex-wrap:wrap;">
          <a class="btn btn-primary" href="/">Volver al inicio</a>
          <a class="btn btn-light" href="/bono-anual-oficiovolt/">Bono anual</a>
          <a class="btn btn-light" href="/zonas-de-servicio/">Zonas</a>
        </div>

        <div style="margin-top:20px;color:var(--muted);font-size:14px;">Si crees que esto es un error, <a href="/contacto/">contáctanos</a> y lo revisamos.</div>
      </div>
    </div>
  </main>
</Layout>
