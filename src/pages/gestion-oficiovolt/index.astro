---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Gestión OficioVolt | Demo" description="Vista de demostración del panel interno de OficioVolt." robots="noindex,nofollow" canonical="/gestion-oficiovolt/">
  <style>
    .admin-page { padding: 42px 0 72px; }
    .admin-shell { display: grid; gap: 22px; }
    .demo-banner {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 18px;
      padding: 18px 20px;
      border: 1px solid #fcd34d;
      border-radius: 18px;
      background: #fffbeb;
      color: #78350f;
    }
    .demo-banner strong { display: block; margin-bottom: 4px; }
    .demo-banner p { margin: 0; font-size: 14px; }
    .demo-badge {
      flex: 0 0 auto;
      border-radius: 999px;
      padding: 7px 11px;
      background: #fef3c7;
      color: #92400e;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;
    }
    .admin-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
    .admin-heading h1 { margin: 0 0 8px; font-size: clamp(2rem, 4vw, 3.3rem); }
    .admin-heading p { margin: 0; color: var(--muted); }
    .admin-actions { display: flex; gap: 10px; flex-wrap: wrap; }
    .admin-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
    .admin-stat { padding: 18px; border: 1px solid var(--line); border-radius: 18px; background: #fff; }
    .admin-stat span { display: block; color: var(--muted); font-size: 12px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
    .admin-stat strong { display: block; margin-top: 8px; font-size: 2rem; line-height: 1; }
    .admin-layout { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(280px, .8fr); gap: 22px; align-items: start; }
    .admin-card { padding: 22px; border: 1px solid var(--line); border-radius: 22px; background: #fff; box-shadow: 0 14px 30px rgba(15,23,42,.05); }
    .admin-card h2 { margin: 0 0 16px; font-size: 1.15rem; }
    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; min-width: 560px; }
    th, td { padding: 13px 10px; border-bottom: 1px solid #e5e7eb; text-align: left; font-size: 14px; }
    th { color: var(--muted); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }
    .row-select { border: 0; padding: 0; background: transparent; color: #b45309; font: inherit; font-weight: 800; cursor: pointer; }
    .row-select:hover, .row-select:focus-visible { text-decoration: underline; }
    tr.is-selected { background: #fffaf0; }
    .status { display: inline-flex; padding: 5px 9px; border-radius: 999px; background: #ecfdf5; color: #047857; font-size: 12px; font-weight: 800; }
    .status.pending { background: #fff7ed; color: #c2410c; }
    .client-summary { display: grid; gap: 16px; }
    .client-summary dl { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 0; }
    .client-summary dl div { padding: 13px; border-radius: 14px; background: #f8fafc; }
    .client-summary dt { color: var(--muted); font-size: 12px; }
    .client-summary dd { margin: 5px 0 0; font-weight: 800; }
    .progress { height: 10px; overflow: hidden; border-radius: 99px; background: #e2e8f0; }
    .progress span { display: block; width: 42%; height: 100%; border-radius: inherit; background: #f59e0b; }
    .admin-note { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.6; }
    @media (max-width: 820px) {
      .admin-grid, .admin-layout { grid-template-columns: 1fr 1fr; }
      .admin-layout { grid-template-columns: 1fr; }
    }
    @media (max-width: 560px) {
      .admin-page { padding-top: 24px; }
      .demo-banner { flex-direction: column; }
      .admin-grid, .client-summary dl { grid-template-columns: 1fr 1fr; }
      .admin-stat strong { font-size: 1.55rem; }
    }
  </style>

  <main class="section-alt admin-page">
    <div class="container admin-shell">
      <div class="demo-banner" role="status">
        <div>
          <strong>Modo demostración</strong>
          <p>Esta vista está publicada temporalmente para enseñar el panel. No conecta con la base de datos ni modifica bonos reales.</p>
        </div>
        <span class="demo-badge">Demo visual</span>
      </div>

      <header class="admin-heading">
        <div>
          <span class="kicker">Gestión interna</span>
          <h1>Panel de bonos</h1>
          <p>Resumen operativo de clientes, saldo y últimas actuaciones.</p>
        </div>
        <div class="admin-actions">
          <a class="btn btn-light" href="/consulta-bono/">Vista cliente</a>
          <a class="btn btn-primary" href="/contacto/">Nueva solicitud</a>
        </div>
      </header>

      <section class="admin-grid" aria-label="Resumen del panel">
        <div class="admin-stat"><span>Bonos activos</span><strong>24</strong></div>
        <div class="admin-stat"><span>Horas disponibles</span><strong>138,5</strong></div>
        <div class="admin-stat"><span>Actuaciones mes</span><strong>17</strong></div>
        <div class="admin-stat"><span>Solicitudes nuevas</span><strong>6</strong></div>
      </section>

      <div class="admin-layout">
        <section class="admin-card">
          <h2>Últimos bonos creados</h2>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Código</th><th>Cliente</th><th>Estado</th><th>Disponible</th><th>Caducidad</th><th></th></tr></thead>
              <tbody>
                <tr data-client="laura"><td>OV-2026-A7K2</td><td>Laura Martínez</td><td><span class="status">Activo</span></td><td>7,5 h</td><td>31/12/2026</td><td><button class="row-select" type="button">Ver ficha</button></td></tr>
                <tr data-client="david"><td>OV-2026-M4P9</td><td>David Sánchez</td><td><span class="status">Activo</span></td><td>4 h</td><td>15/01/2027</td><td><button class="row-select" type="button">Ver ficha</button></td></tr>
                <tr data-client="casa"><td>OV-2026-R8T1</td><td>Casa Vega</td><td><span class="status pending">Pausado</span></td><td>10 h</td><td>03/03/2027</td><td><button class="row-select" type="button">Ver ficha</button></td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <aside class="admin-card client-summary">
          <h2>Ficha del bono</h2>
          <div>
            <strong id="client-name">Laura Martínez</strong>
            <p class="admin-note" id="client-meta">Bono OV-2026-A7K2 · Murcia</p>
          </div>
          <dl>
            <div><dt>Usadas</dt><dd id="client-used">2,5 h</dd></div>
            <div><dt>Disponibles</dt><dd id="client-available">7,5 h</dd></div>
          </dl>
          <div class="progress" id="client-progress" aria-label="25 por ciento consumido"><span></span></div>
          <p class="admin-note" id="client-last-action">Última actuación: revisión de cuadro eléctrico y ajuste de diferencial.</p>
          <button class="btn btn-primary" type="button" id="demo-action">Añadir actuación (demo)</button>
          <a class="btn btn-light" href="/consulta-bono/">Abrir vista cliente</a>
        </aside>
      </div>
    </div>
  </main>

  <script is:inline>
    const demoClients = {
      laura: { name: 'Laura Martínez', meta: 'Bono OV-2026-A7K2 · Murcia', used: '2,5 h', available: '7,5 h', progress: '25%', action: 'Última actuación: revisión de cuadro eléctrico y ajuste de diferencial.' },
      david: { name: 'David Sánchez', meta: 'Bono OV-2026-M4P9 · Molina de Segura', used: '6 h', available: '4 h', progress: '60%', action: 'Última actuación: instalación de dos puntos de luz.' },
      casa: { name: 'Casa Vega', meta: 'Bono OV-2026-R8T1 · Cieza', used: '0 h', available: '10 h', progress: '0%', action: 'Sin actuaciones registradas. Bono pausado temporalmente.' }
    };
    const clientName = document.getElementById('client-name');
    const clientMeta = document.getElementById('client-meta');
    const clientUsed = document.getElementById('client-used');
    const clientAvailable = document.getElementById('client-available');
    const clientProgress = document.querySelector('#client-progress span');
    const clientLastAction = document.getElementById('client-last-action');
    const demoAction = document.getElementById('demo-action');

    function selectDemoClient(key) {
      const client = demoClients[key];
      if (!client) return;
      clientName.textContent = client.name;
      clientMeta.textContent = client.meta;
      clientUsed.textContent = client.used;
      clientAvailable.textContent = client.available;
      clientProgress.style.width = client.progress;
      clientProgress.parentElement.setAttribute('aria-label', `${client.progress} consumido`);
      clientLastAction.textContent = client.action;
      document.querySelectorAll('tbody tr[data-client]').forEach((row) => row.classList.toggle('is-selected', row.dataset.client === key));
    }

    document.querySelectorAll('tbody tr[data-client] .row-select').forEach((button) => {
      button.addEventListener('click', () => selectDemoClient(button.closest('tr').dataset.client));
    });
    demoAction.addEventListener('click', () => {
      demoAction.textContent = 'Actuación preparada (demo)';
      demoAction.classList.remove('btn-primary');
      demoAction.classList.add('btn-green');
    });
    selectDemoClient('laura');
  </script>
</Layout>
