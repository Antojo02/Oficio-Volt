---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Electricista en Vega Media | Pequeños trabajos y urgencias | OficioVolt" description="Atendemos pequeños trabajos eléctricos, urgencias y mejoras puntuales en Vega Media: Molina, Alcantarilla, Lorquí, Ceutí, Alguazas y alrededores." lang="es" canonical="/electricista-vega-media/">
  <section class="hero narrow-hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">Murcia y alrededores</span>
        <h1>Electricista en Vega Media | Pequeños trabajos y urgencias</h1>
        <p class="lead">Atendemos pequeños trabajos eléctricos, urgencias y mejoras puntuales en Vega Media: Molina, Alcantarilla, Lorquí, Ceutí, Alguazas y alrededores.</p>
        <div class="actions">
          <a class="btn btn-primary" href="/#contact">Solicitar visita</a>
          <a class="btn btn-light" href="/bono-anual-oficiovolt/">Bono anual</a>
        </div>
      </div>
      <aside class="quick-card">
        <h3>Atención directa</h3>
        <p>Servicio rápido y claro con atención directa para Murcia y zonas cercanas según agenda y tipo de trabajo.</p>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cards three-cols">
        <article class="card">
          <h3>Diagnóstico y propuesta</h3>
          <p>Revisión clara para elegir la opción correcta: visita, urgencia o intervención.</p>
        </article>
        <article class="card">
          <h3>Cobertura</h3>
          <p>Murcia, Vega Media, Vega Baja y zonas cercanas según disponibilidad y tipo de trabajo.</p>
        </article>
        <article class="card">
          <h3>Contacto directo</h3>
          <p>Escríbenos con foto o vídeo para valorar mejor la incidencia y darte la opción más precisa.</p>
        </article>
      </div>
    </div>
  </section>
</Layout>


